# Copier vers `.env` puis renseigner. `.env` contient des secrets : ne jamais
# le commiter (il est déjà dans .gitignore).

# --- Domaine et TLS --------------------------------------------------------
# Le DNS de ce domaine doit pointer vers l'IP publique du serveur, et les
# ports 80 et 443 doivent être ouverts : Caddy s'en sert pour obtenir le
# certificat Let's Encrypt.
PXLS_DOMAIN=place.example.com
# Adresse utilisée par Let's Encrypt pour les avis d'expiration.
ACME_EMAIL=admin@example.com

# --- Identité de l'instance ------------------------------------------------
PXLS_TITLE=Catboat Place
# À incrémenter à chaque nouvelle toile.
PXLS_CANVAS_CODE=1

# --- Base de données -------------------------------------------------------
POSTGRES_DB=pxls
POSTGRES_USER=pxls
# Générer par exemple avec : openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Connexion OAuth -------------------------------------------------------
# Sans au moins un fournisseur activé, personne ne peut créer de compte.
# L'URL de redirection à déclarer côté fournisseur est :
#   https://<PXLS_DOMAIN>/auth/<service>
# (par exemple https://place.example.com/auth/discord)

# https://discord.com/developers/applications
PXLS_DISCORD_ENABLED=false
PXLS_DISCORD_KEY=
PXLS_DISCORD_SECRET=

# https://console.developers.google.com
PXLS_GOOGLE_ENABLED=false
PXLS_GOOGLE_KEY=
PXLS_GOOGLE_SECRET=

# https://www.reddit.com/prefs/apps
PXLS_REDDIT_ENABLED=false
PXLS_REDDIT_KEY=
PXLS_REDDIT_SECRET=

# --- CAPTCHA (reCAPTCHA invisible, optionnel) ------------------------------
# Le domaine déclaré côté Google doit être PXLS_DOMAIN.
PXLS_CAPTCHA_ENABLED=false
PXLS_CAPTCHA_KEY=
PXLS_CAPTCHA_SECRET=

# --- Divers ----------------------------------------------------------------
# Webhook Discord recevant les annonces publiées depuis la console.
PXLS_ANNOUNCEMENTS_WEBHOOK=

# --- Droits sur ./data -----------------------------------------------------
# UID/GID propriétaire de board.dat, backups/ et logs/. Y mettre les vôtres
# (`id -u` et `id -g`) pour pouvoir sauvegarder et lire ces fichiers sans sudo.
PUID=1000
PGID=1000

# --- Réseau Docker ---------------------------------------------------------
# À changer uniquement si ce sous-réseau est déjà utilisé sur la machine.
# PXLS_WEB_IP doit appartenir à PXLS_SUBNET : le back end n'accepte l'en-tête
# X-Real-IP que s'il provient exactement de cette adresse.
PXLS_SUBNET=172.28.0.0/24
PXLS_WEB_IP=172.28.0.10
